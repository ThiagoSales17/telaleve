{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TelaLeve",
  "version": "0.1.3",
  "identifier": "local.telaleve.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TelaLeve",
        "width": 900,
        "height": 740,
        "minWidth": 660,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.png"
    ],
    "targets": [
      "deb"
    ],
    "category": "Utility",
    "shortDescription": "Compartilhar tela X11 com Android",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgstreamer1.0-0",
          "gstreamer1.0-x",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-nice"
        ]
      }
    }
  }
}
